#!/bin/sh
#
# Compatibility alias for dpictl (the primary CLI as of v2.0). Existing
# scripts that call dpi-proxy-ctl keep working unchanged: every
# argument is passed straight through, with the same exit status.
#
# See scripts/macos/dpictl for the actual implementation.

HERE="$(cd "$(dirname "$0")" && pwd)"

if [ -x "$HERE/dpictl" ]; then
	exec "$HERE/dpictl" "$@"
elif command -v dpictl >/dev/null 2>&1; then
	exec dpictl "$@"
else
	echo "dpi-proxy-ctl: dpictl not found next to this script or in PATH" >&2
	exit 1
fi
