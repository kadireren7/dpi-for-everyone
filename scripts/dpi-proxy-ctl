#!/usr/bin/env bash
#
# Compatibility alias for dpictl (the primary CLI as of v2.0). Existing
# scripts that call dpi-proxy-ctl keep working unchanged: every
# argument is passed straight through, with the same exit status.
#
# See scripts/dpictl for the actual implementation.

set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

if [ -x "$SCRIPT_DIR/dpictl" ]; then
	exec "$SCRIPT_DIR/dpictl" "$@"
elif command -v dpictl >/dev/null 2>&1; then
	exec dpictl "$@"
else
	printf 'dpi-proxy-ctl: dpictl not found next to this script or in PATH\n' >&2
	exit 1
fi
